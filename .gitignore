# --- Python / uv -----------------------------------------------------------
__pycache__/
*.py[oc]
*.egg-info/
build/
dist/
wheels/
.venv/

# --- tooling caches --------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
*.prof

# --- vsa run outputs (multi-GB media) ---------------------------------
# Every workdir produced by `vsa segment --out ...` (default `out/`, any
# `outN/` from manual runs) holds audio/video downloads, segment cuts,
# transcripts, subtitles, and slide frames. All of it is regenerable from
# the source + manifest, and media blobs do not belong in git.
out*/

# straggler artifacts that should never be committed even if they escape
# a workdir (e.g. --out .)
*.partial
*chunk_*.wav
.*.part.*
*.wav.tmp

# --- local run configs -----------------------------------------------------
# Personal/live-run configs (config.cc26.yaml etc.) stay local; template:
# config.example.yaml
config.*.yaml
!config.example.yaml

# --- editors / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
